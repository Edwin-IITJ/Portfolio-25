# Contact Form — Required for the contact form to work in production
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here

# The email address where contact form submissions will be sent
CONTACT_EMAIL=your-email@example.com

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── NDA Case Study Protection ─────────────────────────────────────────────
# Required for the password-protected case study gate to work.
#
# CASE_STUDY_SECRET: Random string (min 32 chars) used to sign session JWTs.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CASE_STUDY_SECRET=replace-with-a-random-32-char-secret
#
# CASE_STUDY_PASSWORD_HASH: SHA-256 hash of your presentation password.
#   Generate: node scripts/hash-password.mjs "your-presentation-password"
CASE_STUDY_PASSWORD_HASH=replace-with-sha256-hash-of-your-password
